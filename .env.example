# ─── Local development ───────────────────────────────
# Copy to frontend/.env.local and adjust. Never commit.

NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Production (Vercel) ─────────────────────────────
# Set in Vercel → Project Settings → Environment Variables (do NOT put in this file).
# Use the public Railway URL of your backend, e.g.:
#   NEXT_PUBLIC_API_URL=https://jobscout-api.up.railway.app
#
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time,
# so a redeploy is required after changing them in Vercel.
